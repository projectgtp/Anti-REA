# Anti-REA v1.0 — L08 generated R8 / ProGuard rules.
# Generated by transformer/native.py generate_r8_rules().
#
# HOW TO APPLY (the app's own Gradle build — REQUIRED):
#   copy this file to app/proguard-rules-antirea.pro and add
#     proguardFiles getDefaultProguardFile(
#         'proguard-android-optimize.txt'),
#         'proguard-rules.pro', 'proguard-rules-antirea.pro'
#   to the release buildType. R8 runs at BUILD time on the
#   app's classes; the anti-rea CLI CANNOT rename classes in
#   an already-built APK, so these rules do nothing if they
#   are only added after the APK exists. Protect with the CLI
#   AFTER the R8 build, on the already-obfuscated APK.
#
# The anti-rea runtime MUST NOT be renamed: the CLI-injected
# smali calls com.antirea.runtime.ReaRuntime (and the other
# runtime classes) by exact class name, and the manifest
# names ReaGuardProvider by exact class name. Keep them all.
-keep class com.antirea.runtime.ReaRuntime { *; }
-keep class com.antirea.runtime.ReaGuardProvider { *; }
-keep class com.antirea.runtime.ReaEnv { *; }
-keep class com.antirea.runtime.ReaIntegrity { *; }
-keep class com.antirea.runtime.ReaTraps { *; }
-keep class com.antirea.runtime.ReaModBlock { *; }
-keep class com.antirea.runtime.ReaTrace { *; }
-keep class com.antirea.runtime.ReaMemory { *; }
-keep class com.antirea.runtime.ReaRepack { *; }
-keep class com.antirea.runtime.ReaNative { *; }
-keep class com.antirea.runtime.ReaAssets { *; }
-keep class com.antirea.runtime.** { *; }
# Obfuscate the app's own classes: repackage everything R8
# renames into one package so original package structure
# (which leaks feature names) does not survive the build.
-repackageclasses 'com.bridge.mvp.rea'
-allowaccessmodification
# NOTE: Android entry points (Activities, Services,
# Receivers, Providers) are kept by the app's own
# proguard-rules.pro / the default Android rules, not here.
# Do NOT add -keep for app classes here: renamed app code
# is the protection; keeping it defeats L08.
